    "fflate": "0.4.9",
    "flatted": "3.4.2",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.12",
    "preact": "10.29.8",
    "source-map-js": "1.2.2",
    "@eslint/eslintrc": {
      "brace-expansion": "1.1.20",
      "minimatch": "3.1.4"
    },
    "@humanwhocodes/config-array": {
      "brace-expansion": "1.1.20",
      "minimatch": "3.1.4"
    },
    "eslint": {
      "brace-expansion": "1.1.20",
      "minimatch": "3.1.4"
    },
    "glob@7": {
      "brace-expansion": "1.1.20",
      "minimatch": "3.1.4"
    },
    "minimatch": "9.0.7",
    "picomatch": "2.3.2",
    "rollup": "3.30.0"
