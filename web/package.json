{
  "name": "krainode-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node ./scripts/build-chains-json.mjs",
    "prebuild": "node ./scripts/build-chains-json.mjs",
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir node_modules/.prerender && node scripts/prerender.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "clsx": "^2.0.0",
    "lucide-react": "^0.263.1",
    "posthog-js": "^1.275.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.6",
    "tailwind-merge": "^1.14.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.0.2",
    "vite": "^4.4.5"
  },
  "overrides": {
    "@babel/core": "7.29.13",
    "ajv": "6.14.0",
    "baseline-browser-mapping": "2.11.37",
    "brace-expansion@1": "1.1.22",
    "brace-expansion@2": "2.1.8",
    "browserslist": "4.29.5",
    "esbuild": "0.25.12",
    "fflate": "0.4.9",
    "flatted": "3.4.4",
    "js-yaml": "4.3.2",
    "minimatch@3": "3.1.5",
    "minimatch@9": "9.0.9",
    "nanoid": "3.3.20",
    "picomatch": "2.3.2",
    "postcss-selector-parser": "6.1.6",
    "preact": "10.27.3",
    "rollup": "3.30.0",
    "source-map-js": "1.2.2"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true,
      "node": true
    },
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaFeatures": {
        "jsx": true
      },
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "plugins": [
      "@typescript-eslint",
      "react-hooks"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:react-hooks/recommended"
    ],
    "rules": {
      "@typescript-eslint/no-explicit-any": "off",
      "react-hooks/rules-of-hooks": "off",
      "react-hooks/exhaustive-deps": "warn"
    }
  }
}
